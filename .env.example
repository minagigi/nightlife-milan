# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The canonical base URL of the site (no trailing slash).
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for SEO metadata (canonical URLs, OG image absolute URLs, hreflang alternates).
# Example: APP_URL="https://nightlifemilan.com"
# Fallback in code: process.env.APP_URL || 'https://nightlifemilan.com'
APP_URL="https://nightlifemilan.com"

# --- Email post-registrazione Eventbrite (attendee email) ---
# RESEND_API_KEY=        # se assente: dry-run, nessun invio reale
# EMAIL_FROM=Nightlife Milan <events@nightlifemilan.com>
# EMAIL_REPLY_TO=
# EMAIL_TEST_OVERRIDE=   # se valorizzato, TUTTI gli invii vanno a questo indirizzo
# EMAIL_WEBHOOK_SECRET=  # auth ?k= del webhook (fallback: CRON_SECRET)
# EMAIL_LINK_SECRET=     # firma HMAC unsubscribe (fallback: CRM_SYNC_SECRET, CRON_SECRET)
# EMAIL_MAX_PER_RUN=50
# EMAIL_SWEEP_SINCE_HOURS=72
