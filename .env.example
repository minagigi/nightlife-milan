# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The canonical base URL of the site (no trailing slash).
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for SEO metadata (canonical URLs, OG image absolute URLs, hreflang alternates).
# Example: APP_URL="https://nightlifemilan.com"
# Fallback in code: process.env.APP_URL || 'https://nightlifemilan.com'
APP_URL="https://nightlifemilan.com"

# Existing private infrastructure used by analytics and the internal CRM.
BLOB_READ_WRITE_TOKEN=""
EVENTBRITE_TOKEN=""
CRON_SECRET=""
INDEXING_SECRET=""
CRM_SYNC_SECRET=""
GOOGLE_INDEXING_CREDENTIALS=""
SEARCH_CONSOLE_SITE_URL="sc-domain:nightlifemilan.com"

# Internal dashboards. CRM falls back to ANALYTICS_* when CRM_* is omitted.
ANALYTICS_USER=""
ANALYTICS_PASSWORD=""
CRM_USER=""
CRM_PASSWORD=""
